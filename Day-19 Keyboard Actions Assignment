Keyboard Actions Assignment
1. What are the different sendKeys available in Actions class and how it differ from normal element.sendKeys()?


import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.interactions.Actions;

public class Reuse {

	public static void main(String[] args) throws InterruptedException {
		
		String AccessLink ="https://www.qa-practice.com/elements/input/email";
	
		// Launch browser and open email input page
		WebDriver driver = new ChromeDriver();
		driver.manage().window().maximize();
		driver.get(AccessLink);
		
		Actions actions = new Actions(driver);
		
		// Using Actions.sendKeys(WebElement, String)
        // Sends keys to a specific element (advanced keyboard action)
		WebElement emailField = driver.findElement(By.id("id_email"));
		actions.sendKeys(emailField,"Ajithkumar1@gmail.com").perform();
		
		// Navigate to password page
		driver.navigate().to("https://www.qa-practice.com/elements/input/passwd");
		
		// Using click().sendKeys()
        // First clicks the element, then sends keys
		WebElement passwordField = driver.findElement(By.id("id_password"));
		actions.click(passwordField).sendKeys("PodaPodi").perform();
		
    Thread.sleep(2000);  // Wait for 2 seconds to see the password being entered

		driver.close();  // Close the browser
}
	
}

