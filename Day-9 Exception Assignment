1. Write a program for List to store list of floating values and fetch all the values.

import java.util.ArrayList;

import java.util.List;


public class ListFloat {

	public static void main(String[] args) {
		
		List<Float> fl  = new ArrayList<>();
		fl.add(10.5f);
		fl.add(20.4f);
		fl.add(17.8f);
		fl.add(22.20f);
		fl.add(72.12f);
		
		System.out.println("Floating values in the list : ");
		
		for(Float element: fl)   {
			System.out.println(element);
			
		}
		

		
	}

}
Output : 
Floating values in the list : 
10.5
20.4
17.8
22.2
72.12

