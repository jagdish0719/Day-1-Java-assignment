3. Write a program to check whether page https://www.demoblaze.com/ contains "Nexus 6" based on pagesource.

package selepractice;

import org.openqa.selenium.edge.EdgeDriver;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.Dimension;
import org.openqa.selenium.WebDriver;

public class Facebook {

	public static void main(String[] args) throws InterruptedException {
		
		WebDriver driver = new ChromeDriver();
		
		driver.manage().window().maximize();
		
		driver.get("https://www.demoblaze.com/");
		
		Thread.sleep(3000);
		
		String pageSource = driver.getPageSource();
		System.out.println(pageSource);
		
		if(pageSource.contains("Nexus 6")) {
			System.out.println("Pass -Nexus 6 is present");
		} else {
			System.out.println("Fail - Nexus 6 is not present");
		}
		
		driver.close();
		
	}

}

Output : 

</body></html>
Pass -Nexus 6 is present



