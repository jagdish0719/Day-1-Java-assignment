2. Create a 3x4 (3 rows 4 cols) array and print the values in it using enhanced for loop.

public class TDArrays {

	public static void main(String[] args) {

		int [][] matrixBox ={
				{10,11,12,13},
				{20,21,22,23},
				{30,31,32,33}
	  };
		
		
		for(int[] row: matrixBox) {
			for(int element : row) {
				System.out.print(element +" ");
			}
			   System.out.println();
		}

}
}

Output:
10 11 12 13 
20 21 22 23 
30 31 32 33 



