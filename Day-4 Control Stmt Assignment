1. Get input from user for salary, if the salary is below 10,000 display as unskilled labour and if salary is between 11,000 to 15,000 display as skilled labour. If salary is above 15,000 display as manager. 
The user gives input as whole number

import java.util.Scanner;

public class SalaryDetails {

	public static void main(String[] args) {

		Scanner don = new Scanner(System.in);
		
		System.out.println("Enter your salary:");
		
		int salary=don.nextInt();
		
		if(salary<10000) {
			System.out.println("unskilled labour");
		} 
		else if(salary<=15000) {
			System.out.println("skilled labour");
		}
		else {
			System.out.println("manager");
		}
		don.close();

	}

}
