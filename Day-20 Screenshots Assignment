2. Navigate to https://www.qa-practice.com/elements/textarea/textareas and then type some message in "First chapter" textbox
     Paste the same in "second chapter" textbox using keyactions.

import org.openqa.selenium.By;
import org.openqa.selenium.Keys;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.interactions.Actions;

public class ReUse {

	public static void main(String[] args) throws InterruptedException  {
		
		String WebAddress ="https://www.qa-practice.com/elements/textarea/textareas";

		WebDriver driver = new ChromeDriver();
		driver.manage().window().maximize();
		driver.get(WebAddress);
		
	
		Actions KeyAction = new Actions(driver);
		WebElement FirstChapter = driver.findElement(By.cssSelector("[id='id_first_chapter']"));
		WebElement SecondChapter = driver.findElement(By.cssSelector("[id='id_second_chapter']"));
		KeyAction.sendKeys(FirstChapter,"hello Universe").perform();
		
		
		KeyAction.keyDown(Keys.CONTROL).sendKeys("a").keyUp(Keys.CONTROL).perform();
		KeyAction.keyDown(Keys.CONTROL).sendKeys("c").keyUp(Keys.CONTROL).perform();
		KeyAction.click(SecondChapter).keyDown(Keys.CONTROL).sendKeys("v").keyUp(Keys.CONTROL).perform();
		
		Thread.sleep(3000);
		
		driver.close();
		
	}

}

