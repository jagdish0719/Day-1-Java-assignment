2. Navigate to https://www.qa-practice.com/elements/dragndrop/images
Drag n Drop the  yellow smiley face

import org.openqa.selenium.By;
import org.openqa.selenium.JavascriptExecutor;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.edge.EdgeDriver;
import org.openqa.selenium.interactions.Actions;

public class Reuse {

	public static void main(String[] args) throws InterruptedException {
		
		String url ="https://www.qa-practice.com/elements/dragndrop/images";
		
		WebDriver driver = new EdgeDriver();
		driver.manage().window().maximize();
		driver.get(url);
		
		Actions action = new Actions(driver);
		JavascriptExecutor js = (JavascriptExecutor)driver;
		
		WebElement drag = driver.findElement(By.id("rect-droppable1"));
		WebElement drop = driver.findElement(By.id("rect-droppable2"));
		action.dragAndDrop(drag, drop).perform();

		js.executeScript("window.scrollBy(0,500)");
		
		System.out.println("Smiley face dragged successfully");
		driver.quit();
		
		
	}
}
	
